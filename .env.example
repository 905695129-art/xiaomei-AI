DATABASE_URL=
# Required by docker-compose.yml; use a long random value (do not reuse production credentials).
POSTGRES_PASSWORD=replace-with-a-long-random-password
SESSION_SECRET=
STORAGE_ENDPOINT=
STORAGE_PUBLIC_URL=
STORAGE_REGION=auto
STORAGE_BUCKET=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
PAYMENT_PROVIDER=disabled

# Transactional email (Resend). Configure a verified sender before enabling these flows.
RESEND_API_KEY=
EMAIL_FROM=
APP_URL=http://localhost:3000
REQUIRE_VERIFIED_EMAIL=false
