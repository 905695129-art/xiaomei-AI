DATABASE_URL=
# Required by docker-compose.yml; use a long random value (do not reuse production credentials).
POSTGRES_PASSWORD=replace-with-a-long-random-password
STORAGE_ENDPOINT=
STORAGE_PUBLIC_URL=
STORAGE_REGION=auto
STORAGE_BUCKET=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
PAYMENT_PROVIDER=disabled

# Transactional email is disabled by default. Only select a provider after region/compliance review.
EMAIL_PROVIDER=disabled # disabled | resend (Resend is not the mainland production default)
RESEND_API_KEY=
EMAIL_FROM=
# Public HTTPS origin. Set this to the final mainland production domain.
# Used for absolute Open Graph/share metadata and canonical app identity.
APP_URL=http://localhost:3000
REQUIRE_VERIFIED_EMAIL=false
